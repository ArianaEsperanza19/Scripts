# Funciones de búsqueda y apertura

# Abre un archivo encontrado con el programa que tú elijas
# Uso: fop vim  (o fop vlc, fop gimp, etc.)
fop() {
	local programa="$1"
	local archivo
	archivo=$(fzf)

	if [ -n "$archivo" ]; then
		"$programa" "$archivo"
	else
		echo "No se seleccionó ningún archivo."
	fi
}

# Vista previa rápida de archivos con fzf y bat
# Uso: fcat
fcat() {
	local archivo
	archivo=$(fzf --preview 'bat --style=numbers --color=always --line-range :500 {}')

	if [ -n "$archivo" ]; then
		bat --style=numbers --color=always "$archivo"
	fi
}

